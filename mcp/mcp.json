{
  "mcpServers": {
    "estandares": {
      "command": "uvx",
      "args": [
        "mcp-server-filesystem@latest",
        "${ESTANDARES_PATH}"
      ],
      "env": { "FASTMCP_LOG_LEVEL": "ERROR" },
      "disabled": false,
      "autoApprove": ["read_file", "list_directory", "search_files"]
    }
  }
}
